# Railway Postgres.
# Local dev + Vercel use the PUBLIC proxy endpoint.
# The worker running ON Railway should use the private URL instead (no egress cost).
DATABASE_URL="postgresql://postgres:PASSWORD@turntable.proxy.rlwy.net:45939/railway"

# Inside Railway, reference Postgres directly:
# DATABASE_URL="${{Postgres.DATABASE_URL}}"

# Unique per worker instance. Used to claim jobs and trace which box scraped what.
WORKER_ID="worker-local"

# How many browser contexts run concurrently in this worker.
WORKER_CONCURRENCY=1

# Where Playwright persistent profiles live.
# On Railway, point this at a mounted volume so logins survive deploys.
PROFILE_DIR="./profiles"

# Local response evidence (JSON and screenshots). Contains private answers.
# Mount a persistent volume here in production; keep it outside version control.
CAPTURE_DIR="./captures"

# headless=false is far less detectable, and required for first-time manual login.
# On Railway (no display) this must be true, or run under xvfb.
HEADLESS=false

# Use real Google Chrome instead of Playwright's bundled Chromium.
# Different fingerprint: stock Chromium lacks Chrome branding, proprietary
# codecs and Widevine, and anti-bot scoring notices. Cheapest credibility win.
# Leave UNSET on Railway — the Playwright image ships Chromium, not Chrome.
BROWSER_CHANNEL="chrome"

# Seconds a claimed job may sit before another worker reclaims it.
STALE_JOB_SECONDS=900

# ---------------------------------------------------------------------------
# Outbound proxy (optional locally, effectively required on Railway)
#
# Railway egresses from shared DATACENTER IPs — the ranges Cloudflare scores
# worst. Pair a residential proxy with the headed/xvfb setup in the Dockerfile.
#
# Use a STICKY session, not a rotating one. These are logged-in accounts: an
# account whose IP changes every request looks stolen and gets banned faster
# than one that stays put. Scale by adding identities, not by rotating IPs.
# ---------------------------------------------------------------------------
# PROXY_SERVER="http://proxy.example.com:8000"
# PROXY_USERNAME=""
# PROXY_PASSWORD=""

# Per-platform override, so each account keeps its own pinned exit IP:
# PROXY_SERVER_CHATGPT="http://sticky-session-1.proxy.example.com:8000"
# PROXY_SERVER_CLAUDE="http://sticky-session-2.proxy.example.com:8000"
# PROXY_SERVER_GEMINI="http://sticky-session-3.proxy.example.com:8000"

# ---------------------------------------------------------------------------
# Hosted browser (optional) — overrides the local browser entirely.
#
# When set, the worker attaches to a remote browser over CDP instead of
# launching one. The provider then owns stealth, residential proxies and the
# display, so xvfb, BROWSER_CHANNEL and PROXY_* above are all bypassed.
#
# Works with Browserbase, Steel.dev, Browserless, or any Chrome started with
# --remote-debugging-port. Per-platform URLs keep each account on its own
# persistent remote session.
# ---------------------------------------------------------------------------
# BROWSER_CDP_URL="wss://connect.browserbase.com?apiKey=...&contextId=..."
# BROWSER_CDP_URL_CHATGPT="wss://connect.browserbase.com?apiKey=...&contextId=ctx-chatgpt"
# BROWSER_CDP_URL_CLAUDE="wss://connect.browserbase.com?apiKey=...&contextId=ctx-claude"

# Market condition. The Bangtao sheet asks for "Neutral (no location set)", so
# the browser volunteers UTC and en-US and grants no geolocation permission.
# Note: this does NOT neutralise the exit IP — that still reads as wherever the
# worker runs. Full neutrality needs a proxy exit in the target locale.
LOCALE="en-US"
TIMEZONE="UTC"

# Gap between prompts. 20-60s reads as a person doing research; 2-5s is a
# sustained ~1 prompt/min for an hour, which no human produces.
PROMPT_GAP_MIN_MS=20000
PROMPT_GAP_MAX_MS=60000

# Stop after this many consecutive failures rather than retrying into a wall.
MAX_CONSECUTIVE_FAILURES=3
# Stop cleanly after this many prompts per session. 0 = unlimited.
# 40 questions then a break looks like research; 240 without one does not.
SESSION_BUDGET=30
