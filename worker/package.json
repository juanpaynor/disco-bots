{
  "name": "aidisco-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "prisma": {
    "schema": "../prisma/schema.prisma"
  },
  "scripts": {
    "disco": "node --import tsx src/disco.ts",
    "test:disco": "node --import tsx --test src/local-run.test.ts src/disco-wizard.test.ts src/disco-accounts.test.ts src/browser-install.test.ts",
    "package:disco": "node scripts/package-cli.mjs",
    "test:accounts": "node --import tsx --test src/disco-accounts.test.ts src/disco-accounts-browser.test.ts",
    "test:chatgpt": "node --import tsx --test src/bots/chatgpt.test.ts",
    "generate": "prisma generate",
    "db:push": "prisma db push",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "login": "tsx src/login.ts",
    "seed": "tsx src/seed.ts",
    "smoke": "tsx src/smoke.ts",
    "verify:claude": "tsx src/verify-claude.ts",
    "test:claude": "tsx --test src/bots/claude.test.ts",
    "ipcheck": "tsx src/ipcheck.ts",
    "cleanup": "tsx src/cleanup.ts",
    "inspect": "tsx src/inspect.ts",
    "export": "tsx src/export.ts",
    "dash": "tsx src/dash.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "0.28.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
